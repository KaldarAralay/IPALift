{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipalift.local/schemas/interaction-model.schema.json",
  "title": "IPALift deterministic interaction evidence model",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"enum": ["exact", "candidate_set", "unresolved"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "nullableString": {"type": ["string", "null"]},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "nonEmptyStringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "object",
      "required": ["kind", "source", "source_object", "field", "source_address", "confidence", "basis", "details"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_object": {"$ref": "#/$defs/nullableString"},
        "field": {"$ref": "#/$defs/nullableString"},
        "source_address": {"$ref": "#/$defs/nullableString"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "basis": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "inputArtifact": {
      "type": "object",
      "required": ["artifact", "path", "sha256"],
      "properties": {
        "artifact": {"enum": ["functions", "callgraph", "recovered-code-index", "objc-dispatch", "platform-api-map", "native-type-flow", "ui-model"]},
        "path": {"type": "string", "pattern": "^analysis/[^/]+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "required": ["id", "name", "classification", "controller_class_name"],
      "properties": {
        "id": {"type": "string", "pattern": "^ui-screen"},
        "name": {"type": "string", "minLength": 1},
        "classification": {"$ref": "#/$defs/classification"},
        "controller_class_name": {"$ref": "#/$defs/nullableString"}
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["id", "kind", "classification", "screen_ids", "element_ids", "connection_ids", "event", "selector", "callback_contract", "notification_name", "timer_interval", "handler_method_ids", "handler_function_ids", "registration_function_ids", "evidence", "failure_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^interaction-trigger:[0-9a-f]{20}$"},
        "kind": {"enum": ["ui_action", "lifecycle", "delegate", "notification", "timer", "callback"]},
        "classification": {"$ref": "#/$defs/classification"},
        "screen_ids": {"$ref": "#/$defs/stringSet"},
        "element_ids": {"$ref": "#/$defs/stringSet"},
        "connection_ids": {"$ref": "#/$defs/stringSet"},
        "event": {"$ref": "#/$defs/nullableString"},
        "selector": {"$ref": "#/$defs/nullableString"},
        "callback_contract": {"$ref": "#/$defs/nullableString"},
        "notification_name": {"$ref": "#/$defs/nullableString"},
        "timer_interval": {"$ref": "#/$defs/nullableString"},
        "handler_method_ids": {"$ref": "#/$defs/stringSet"},
        "handler_function_ids": {"$ref": "#/$defs/stringSet"},
        "registration_function_ids": {"$ref": "#/$defs/stringSet"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "failure_reasons": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "callNode": {
      "type": "object",
      "required": ["function_id", "depth", "path_classification", "method_ids", "class_names", "selectors", "via_edge_ids"],
      "properties": {
        "function_id": {"type": "string", "minLength": 1},
        "depth": {"$ref": "#/$defs/nonNegativeInteger"},
        "path_classification": {"$ref": "#/$defs/classification"},
        "method_ids": {"$ref": "#/$defs/stringSet"},
        "class_names": {"$ref": "#/$defs/stringSet"},
        "selectors": {"$ref": "#/$defs/stringSet"},
        "via_edge_ids": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "callEdge": {
      "type": "object",
      "required": ["id", "kind", "caller_function_id", "target_function_id", "call_site", "classification", "evidence", "failure_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^interaction-call-edge:[0-9a-f]{20}$"},
        "kind": {"enum": ["direct", "objective_c_dynamic"]},
        "caller_function_id": {"type": "string", "minLength": 1},
        "target_function_id": {"$ref": "#/$defs/nullableString"},
        "call_site": {},
        "classification": {"$ref": "#/$defs/classification"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "failure_reasons": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "callSlice": {
      "type": "object",
      "required": ["id", "trigger_id", "root_function_ids", "max_depth", "max_functions", "max_edges", "nodes", "edges", "truncated", "failure_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^interaction-call-slice:[0-9a-f]{20}$"},
        "trigger_id": {"type": "string", "pattern": "^interaction-trigger:[0-9a-f]{20}$"},
        "root_function_ids": {"$ref": "#/$defs/stringSet"},
        "max_depth": {"$ref": "#/$defs/positiveInteger"},
        "max_functions": {"$ref": "#/$defs/positiveInteger"},
        "max_edges": {"$ref": "#/$defs/positiveInteger"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/callNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/callEdge"}},
        "truncated": {"type": "boolean"},
        "failure_reasons": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "resourceCandidate": {
      "type": "object",
      "required": ["kind", "value", "classification", "failure_reason"],
      "properties": {
        "kind": {"enum": ["string", "asset"]},
        "value": {"type": "string"},
        "candidate_ids": {"$ref": "#/$defs/stringSet"},
        "classification": {"const": "candidate_set"},
        "failure_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "effectDetails": {
      "type": "object",
      "properties": {
        "identifier": {},
        "resource_candidates": {"type": "array", "items": {"$ref": "#/$defs/resourceCandidate"}},
        "offset": {},
        "width": {},
        "expression": {},
        "pseudocode_line": {},
        "address": {},
        "symbols": {"type": "array", "items": {"type": "string"}},
        "class_name": {"type": "string"},
        "member_kind": {"enum": ["ivar", "property"]},
        "member_name": {"type": "string"},
        "frameworks": {"type": "array", "items": {"type": "string"}},
        "categories": {"type": "array", "items": {"type": "string"}},
        "literal_arguments": {"type": "array", "items": {"type": "string"}},
        "timer_interval": {"$ref": "#/$defs/nullableString"}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["id", "trigger_id", "kind", "classification", "function_id", "call_site", "selector", "symbol", "operation", "state_id", "source_screen_ids", "destination_screen_ids", "ui_operation_ids", "platform_dependency_ids", "details", "evidence", "failure_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^interaction-effect:[0-9a-f]{20}$"},
        "trigger_id": {"type": "string", "pattern": "^interaction-trigger:[0-9a-f]{20}$"},
        "kind": {"enum": ["state_read", "state_write", "navigation", "ui_update", "persistence_read", "persistence_write", "persistence_access", "network_request", "notification_post", "timer_schedule", "platform_api"]},
        "classification": {"$ref": "#/$defs/classification"},
        "function_id": {"$ref": "#/$defs/nullableString"},
        "call_site": {"$ref": "#/$defs/nullableString"},
        "selector": {"$ref": "#/$defs/nullableString"},
        "symbol": {"$ref": "#/$defs/nullableString"},
        "operation": {"$ref": "#/$defs/nullableString"},
        "state_id": {"$ref": "#/$defs/nullableString"},
        "source_screen_ids": {"$ref": "#/$defs/stringSet"},
        "destination_screen_ids": {"$ref": "#/$defs/stringSet"},
        "ui_operation_ids": {"$ref": "#/$defs/stringSet"},
        "platform_dependency_ids": {"$ref": "#/$defs/stringSet"},
        "details": {"$ref": "#/$defs/effectDetails"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "failure_reasons": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["id", "trigger_id", "classification", "screen_ids", "handler_method_ids", "handler_function_ids", "call_slice_id", "effect_ids", "evidence", "failure_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^interaction-chain:[0-9a-f]{20}$"},
        "trigger_id": {"type": "string", "pattern": "^interaction-trigger:[0-9a-f]{20}$"},
        "classification": {"$ref": "#/$defs/classification"},
        "screen_ids": {"$ref": "#/$defs/stringSet"},
        "handler_method_ids": {"$ref": "#/$defs/stringSet"},
        "handler_function_ids": {"$ref": "#/$defs/stringSet"},
        "call_slice_id": {"type": "string", "pattern": "^interaction-call-slice:[0-9a-f]{20}$"},
        "effect_ids": {"$ref": "#/$defs/stringSet"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "failure_reasons": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "pseudocodeArtifact": {
      "type": "object",
      "required": ["function_id", "path", "sha256", "size"],
      "properties": {
        "function_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"$ref": "#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": false
    },
    "screenIndex": {
      "type": "object",
      "required": ["screen_id", "interaction_ids"],
      "properties": {
        "screen_id": {"type": "string", "minLength": 1},
        "interaction_ids": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "triggerKindIndex": {
      "type": "object",
      "required": ["trigger_kind", "trigger_ids"],
      "properties": {
        "trigger_kind": {"enum": ["ui_action", "lifecycle", "delegate", "notification", "timer", "callback"]},
        "trigger_ids": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "effectKindIndex": {
      "type": "object",
      "required": ["effect_kind", "effect_ids"],
      "properties": {
        "effect_kind": {"enum": ["state_read", "state_write", "navigation", "ui_update", "persistence_read", "persistence_write", "persistence_access", "network_request", "notification_post", "timer_schedule", "platform_api"]},
        "effect_ids": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "handlerIndex": {
      "type": "object",
      "required": ["function_id", "interaction_ids"],
      "properties": {
        "function_id": {"type": "string", "minLength": 1},
        "interaction_ids": {"$ref": "#/$defs/stringSet"}
      },
      "additionalProperties": false
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "allOf": [
    {"$ref": "report-envelope.schema.json"},
    {
      "properties": {
        "artifact": {"const": "interaction-model"},
        "facts": {
          "type": "object",
          "required": ["catalog", "input_artifacts", "summary", "screens", "triggers", "call_slices", "effects", "interactions", "pseudocode_artifacts", "indexes", "evidence_boundary"],
          "properties": {
            "catalog": {
              "type": "object",
              "required": ["catalog_id", "catalog_version", "sha256", "lifecycle_selector_count", "registration_selector_count", "effect_selector_count", "imported_effect_count", "bounds"],
              "properties": {
                "catalog_id": {"const": "ipalift-interaction-apis"},
                "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "lifecycle_selector_count": {"$ref": "#/$defs/positiveInteger"},
                "registration_selector_count": {"$ref": "#/$defs/positiveInteger"},
                "effect_selector_count": {"$ref": "#/$defs/positiveInteger"},
                "imported_effect_count": {"$ref": "#/$defs/positiveInteger"},
                "bounds": {
                  "type": "object",
                  "required": ["max_call_depth", "max_functions_per_slice", "max_edges_per_slice", "max_pseudocode_bytes_per_function", "max_total_pseudocode_bytes"],
                  "properties": {
                    "max_call_depth": {"$ref": "#/$defs/positiveInteger"},
                    "max_functions_per_slice": {"$ref": "#/$defs/positiveInteger"},
                    "max_edges_per_slice": {"$ref": "#/$defs/positiveInteger"},
                    "max_pseudocode_bytes_per_function": {"$ref": "#/$defs/positiveInteger"},
                    "max_total_pseudocode_bytes": {"$ref": "#/$defs/positiveInteger"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "input_artifacts": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/inputArtifact"}},
            "summary": {
              "type": "object",
              "required": ["trigger_count", "interaction_count", "effect_count", "call_slice_count", "call_slice_function_count", "call_slice_edge_count", "truncated_call_slice_count", "pseudocode_artifact_count", "state_read_count", "state_write_count", "navigation_effect_count", "ui_update_count", "persistence_effect_count", "network_request_count", "notification_post_count", "timer_schedule_count", "platform_api_effect_count", "trigger_kind_counts", "effect_kind_counts", "classified_record_count", "classification_counts", "failure_reason_counts", "error_count"],
              "properties": {
                "trigger_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "interaction_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "effect_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "call_slice_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "call_slice_function_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "call_slice_edge_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "truncated_call_slice_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "pseudocode_artifact_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "state_read_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "state_write_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "navigation_effect_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "ui_update_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "persistence_effect_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "network_request_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "notification_post_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "timer_schedule_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "platform_api_effect_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "trigger_kind_counts": {
                  "type": "object",
                  "required": ["ui_action", "lifecycle", "delegate", "notification", "timer", "callback"],
                  "properties": {
                    "ui_action": {"$ref": "#/$defs/nonNegativeInteger"},
                    "lifecycle": {"$ref": "#/$defs/nonNegativeInteger"},
                    "delegate": {"$ref": "#/$defs/nonNegativeInteger"},
                    "notification": {"$ref": "#/$defs/nonNegativeInteger"},
                    "timer": {"$ref": "#/$defs/nonNegativeInteger"},
                    "callback": {"$ref": "#/$defs/nonNegativeInteger"}
                  },
                  "additionalProperties": false
                },
                "effect_kind_counts": {
                  "type": "object",
                  "required": ["state_read", "state_write", "navigation", "ui_update", "persistence_read", "persistence_write", "persistence_access", "network_request", "notification_post", "timer_schedule", "platform_api"],
                  "properties": {
                    "state_read": {"$ref": "#/$defs/nonNegativeInteger"},
                    "state_write": {"$ref": "#/$defs/nonNegativeInteger"},
                    "navigation": {"$ref": "#/$defs/nonNegativeInteger"},
                    "ui_update": {"$ref": "#/$defs/nonNegativeInteger"},
                    "persistence_read": {"$ref": "#/$defs/nonNegativeInteger"},
                    "persistence_write": {"$ref": "#/$defs/nonNegativeInteger"},
                    "persistence_access": {"$ref": "#/$defs/nonNegativeInteger"},
                    "network_request": {"$ref": "#/$defs/nonNegativeInteger"},
                    "notification_post": {"$ref": "#/$defs/nonNegativeInteger"},
                    "timer_schedule": {"$ref": "#/$defs/nonNegativeInteger"},
                    "platform_api": {"$ref": "#/$defs/nonNegativeInteger"}
                  },
                  "additionalProperties": false
                },
                "classified_record_count": {"$ref": "#/$defs/nonNegativeInteger"},
                "classification_counts": {
                  "type": "object",
                  "required": ["exact", "candidate_set", "unresolved"],
                  "properties": {
                    "exact": {"$ref": "#/$defs/nonNegativeInteger"},
                    "candidate_set": {"$ref": "#/$defs/nonNegativeInteger"},
                    "unresolved": {"$ref": "#/$defs/nonNegativeInteger"}
                  },
                  "additionalProperties": false
                },
                "failure_reason_counts": {"$ref": "#/$defs/countMap"},
                "error_count": {"const": 0}
              },
              "additionalProperties": false
            },
            "screens": {"type": "array", "items": {"$ref": "#/$defs/screen"}},
            "triggers": {"type": "array", "items": {"$ref": "#/$defs/trigger"}},
            "call_slices": {"type": "array", "items": {"$ref": "#/$defs/callSlice"}},
            "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
            "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
            "pseudocode_artifacts": {"type": "array", "items": {"$ref": "#/$defs/pseudocodeArtifact"}},
            "indexes": {
              "type": "object",
              "required": ["interactions_by_screen", "triggers_by_kind", "effects_by_kind", "interactions_by_handler"],
              "properties": {
                "interactions_by_screen": {"type": "array", "items": {"$ref": "#/$defs/screenIndex"}},
                "triggers_by_kind": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/triggerKindIndex"}},
                "effects_by_kind": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/effectKindIndex"}},
                "interactions_by_handler": {"type": "array", "items": {"$ref": "#/$defs/handlerIndex"}}
              },
              "additionalProperties": false
            },
            "evidence_boundary": {
              "type": "object",
              "required": ["application_specific_rules_used", "names_used_to_invent_behavior", "function_level_resources_promoted_to_arguments", "objective_c_dynamic_edges_treated_as_facts", "call_slices_claim_runtime_coverage", "ui_model_reparsed_or_duplicated", "upstream_artifacts_preserved"],
              "properties": {
                "application_specific_rules_used": {"const": false},
                "names_used_to_invent_behavior": {"const": false},
                "function_level_resources_promoted_to_arguments": {"const": false},
                "objective_c_dynamic_edges_treated_as_facts": {"const": false},
                "call_slices_claim_runtime_coverage": {"const": false},
                "ui_model_reparsed_or_duplicated": {"const": false},
                "upstream_artifacts_preserved": {"const": true}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "subject_id", "confidence", "basis"],
            "properties": {
              "id": {"type": "string", "pattern": "^interaction-hypothesis:[0-9a-f]{20}$"},
              "kind": {"const": "candidate_interaction_record"},
              "subject_id": {"type": "string", "minLength": 1},
              "confidence": {"const": "medium"},
              "basis": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  ]
}
