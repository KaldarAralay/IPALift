{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipalift.local/schemas/cpp-object-model.schema.json",
  "title": "IPALift C++ object model report",
  "type": "object",
  "required": ["schema_version", "artifact", "facts", "hypotheses", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"const": "cpp-object-model"},
    "facts": {
      "type": "object",
      "required": ["abi_records", "input_artifacts", "summary", "classes", "rtti_records", "inheritance_relationships", "vtables", "address_points", "vtable_slots", "special_member_functions", "vtable_assignments", "indirect_callsites", "pseudocode_artifacts", "indexes", "evidence_boundary"],
      "properties": {
        "abi_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/abi"}},
        "input_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputArtifact"}},
        "summary": {"$ref": "#/$defs/summary"},
        "classes": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "rtti_records": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "inheritance_relationships": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "vtables": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "address_points": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "vtable_slots": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "special_member_functions": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "vtable_assignments": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "indirect_callsites": {"type": "array", "items": {"$ref": "#/$defs/classifiedRecord"}},
        "pseudocode_artifacts": {"type": "array", "items": {"$ref": "#/$defs/pseudocodeArtifact"}},
        "indexes": {
          "type": "object",
          "required": ["classes", "vtables", "functions", "callsites"],
          "properties": {
            "classes": {"type": "array", "items": {"$ref": "#/$defs/indexRecord"}},
            "vtables": {"type": "array", "items": {"$ref": "#/$defs/indexRecord"}},
            "functions": {"type": "array", "items": {"$ref": "#/$defs/indexRecord"}},
            "callsites": {"type": "array", "items": {"$ref": "#/$defs/indexRecord"}}
          },
          "additionalProperties": false
        },
        "evidence_boundary": {
          "type": "object",
          "required": ["abi_evidence_only", "names_strings_selectors_used_as_behavior_evidence", "gameplay_semantics_inferred", "direct_callgraph_preserved", "objc_dispatch_preserved", "objc_type_flow_preserved", "platform_api_map_preserved", "unsupported_abi_patterns_promoted"],
          "properties": {
            "abi_evidence_only": {"const": true},
            "names_strings_selectors_used_as_behavior_evidence": {"const": false},
            "gameplay_semantics_inferred": {"const": false},
            "direct_callgraph_preserved": {"const": true},
            "objc_dispatch_preserved": {"const": true},
            "objc_type_flow_preserved": {"const": true},
            "platform_api_map_preserved": {"const": true},
            "unsupported_abi_patterns_promoted": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "callsite_id", "target_function_id", "classification", "confidence", "basis"],
        "properties": {
          "id": {"type": "string", "pattern": "^cpp-virtual-edge:"},
          "kind": {"const": "virtual_dispatch_target"},
          "callsite_id": {"type": "string", "pattern": "^cpp-indirect-callsite:"},
          "target_function_id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["exact", "candidate_set"]},
          "confidence": {"enum": ["high", "medium"]},
          "basis": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "count", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"anyOf": [{"type": "string", "pattern": "^0x[0-9a-f]+$"}, {"type": "null"}]},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputArtifact": {
      "type": "object",
      "required": ["artifact", "path", "sha256"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["name", "bits", "pointer_size", "endianness"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "bits": {"enum": [32, 64]},
        "pointer_size": {"enum": [4, 8]},
        "endianness": {"enum": ["little", "big"]}
      },
      "additionalProperties": false
    },
    "abi": {
      "type": "object",
      "required": ["id", "name", "version", "primary_source", "supported_structures", "architectures", "assumptions"],
      "properties": {
        "id": {"const": "itanium-cxx-abi"},
        "name": {"const": "Itanium C++ ABI"},
        "version": {"type": "string", "minLength": 1},
        "primary_source": {"type": "string", "format": "uri"},
        "supported_structures": {"$ref": "#/$defs/stringArray"},
        "architectures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/architecture"}},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["exact", "candidate_set", "unresolved"],
      "properties": {
        "exact": {"type": "integer", "minimum": 0},
        "candidate_set": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["class_count", "rtti_record_count", "inheritance_relationship_count", "vtable_count", "address_point_count", "vtable_slot_count", "special_member_function_count", "vtable_assignment_count", "indirect_callsite_count", "virtual_callsite_count", "hypothesis_edge_count", "classification_counts", "failure_reason_counts"],
      "properties": {
        "class_count": {"type": "integer", "minimum": 0},
        "rtti_record_count": {"type": "integer", "minimum": 0},
        "inheritance_relationship_count": {"type": "integer", "minimum": 0},
        "vtable_count": {"type": "integer", "minimum": 0},
        "address_point_count": {"type": "integer", "minimum": 0},
        "vtable_slot_count": {"type": "integer", "minimum": 0},
        "special_member_function_count": {"type": "integer", "minimum": 0},
        "vtable_assignment_count": {"type": "integer", "minimum": 0},
        "indirect_callsite_count": {"type": "integer", "minimum": 0},
        "virtual_callsite_count": {"type": "integer", "minimum": 0},
        "hypothesis_edge_count": {"type": "integer", "minimum": 0},
        "classification_counts": {"$ref": "#/$defs/counts"},
        "failure_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source", "address", "basis"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/address"},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "classifiedRecord": {
      "type": "object",
      "required": ["id", "architecture", "classification", "confidence", "provenance", "evidence", "failure_reasons"],
      "properties": {
        "id": {"type": "string", "pattern": "^cpp-"},
        "architecture": {"type": "string", "minLength": 1},
        "classification": {"enum": ["exact", "candidate_set", "unresolved"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "provenance": {"$ref": "#/$defs/stringArray"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "failure_reasons": {"$ref": "#/$defs/stringArray"},
        "abi": {"type": "string"},
        "abi_variant": {"type": "string"},
        "address": {"$ref": "#/$defs/address"},
        "end_address": {"$ref": "#/$defs/address"},
        "header_address": {"$ref": "#/$defs/address"},
        "slot_address": {"$ref": "#/$defs/address"},
        "raw_target_address": {"$ref": "#/$defs/address"},
        "canonical_target_address": {"$ref": "#/$defs/address"},
        "base_rtti_address": {"$ref": "#/$defs/address"},
        "rtti_address": {"$ref": "#/$defs/address"},
        "type_name_address": {"$ref": "#/$defs/address"},
        "pointer_cell_address": {"$ref": "#/$defs/address"},
        "stored_address": {"$ref": "#/$defs/address"},
        "call_site": {"$ref": "#/$defs/address"},
        "address_point_id": {"type": "string"},
        "address_point_ids": {"$ref": "#/$defs/stringArray"},
        "base_class_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "candidate_address_point_ids": {"$ref": "#/$defs/stringArray"},
        "candidate_class_ids": {"$ref": "#/$defs/stringArray"},
        "candidate_slot_ids": {"$ref": "#/$defs/stringArray"},
        "class_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "class_ids": {"$ref": "#/$defs/stringArray"},
        "derived_class_id": {"type": "string"},
        "special_member_class_ids": {"$ref": "#/$defs/stringArray"},
        "vtable_id": {"type": "string"},
        "function_id": {"type": "string"},
        "function_ids": {"$ref": "#/$defs/stringArray"},
        "caller_function_id": {"type": "string"},
        "caller_method_ids": {"$ref": "#/$defs/stringArray"},
        "caller_objc_class_names": {"$ref": "#/$defs/stringArray"},
        "possible_target_function_ids": {"$ref": "#/$defs/stringArray"},
        "related_function_ids": {"$ref": "#/$defs/stringArray"},
        "related_objc_method_ids": {"$ref": "#/$defs/stringArray"},
        "related_objc_class_names": {"$ref": "#/$defs/stringArray"},
        "inheritance_relationship_ids": {"$ref": "#/$defs/stringArray"},
        "rtti_ids": {"$ref": "#/$defs/stringArray"},
        "slot_ids": {"$ref": "#/$defs/stringArray"},
        "special_member_ids": {"$ref": "#/$defs/stringArray"},
        "target_function_ids": {"$ref": "#/$defs/stringArray"},
        "target_symbols": {"$ref": "#/$defs/stringArray"},
        "vtable_assignment_ids": {"$ref": "#/$defs/stringArray"},
        "vtable_ids": {"$ref": "#/$defs/stringArray"},
        "symbol": {"type": "string"},
        "mangled_type_encoding": {"type": "string"},
        "display_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "runtime_layout": {"anyOf": [{"enum": ["class_type_info", "si_class_type_info", "vmi_class_type_info"]}, {"type": "null"}]},
        "runtime_vtable_symbol": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "type_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "kind": {"type": "string"},
        "object_expression": {"type": "string"},
        "offset": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
        "offset_to_top": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
        "slot_index": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "slot_offset": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "pseudocode_line": {"type": "integer", "minimum": 1},
        "primary": {"type": "boolean"},
        "public": {"type": "boolean"},
        "virtual": {"type": "boolean"},
        "pure_virtual": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "pseudocodeArtifact": {
      "type": "object",
      "required": ["function_id", "path", "sha256"],
      "properties": {
        "function_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "indexRecord": {
      "type": "object",
      "properties": {
        "class_id": {"type": "string"},
        "vtable_id": {"type": "string"},
        "function_id": {"type": "string"},
        "callsite_id": {"type": "string"},
        "address_point_ids": {"$ref": "#/$defs/stringArray"},
        "candidate_class_ids": {"$ref": "#/$defs/stringArray"},
        "candidate_vtable_slot_ids": {"$ref": "#/$defs/stringArray"},
        "class_ids": {"$ref": "#/$defs/stringArray"},
        "function_ids": {"$ref": "#/$defs/stringArray"},
        "indirect_callsite_ids": {"$ref": "#/$defs/stringArray"},
        "method_ids": {"$ref": "#/$defs/stringArray"},
        "possible_incoming_virtual_callsite_ids": {"$ref": "#/$defs/stringArray"},
        "possible_target_function_ids": {"$ref": "#/$defs/stringArray"},
        "rtti_ids": {"$ref": "#/$defs/stringArray"},
        "slot_ids": {"$ref": "#/$defs/stringArray"},
        "special_member_ids": {"$ref": "#/$defs/stringArray"},
        "vtable_assignment_ids": {"$ref": "#/$defs/stringArray"},
        "vtable_ids": {"$ref": "#/$defs/stringArray"},
        "vtable_slot_ids": {"$ref": "#/$defs/stringArray"}
      },
      "additionalProperties": false,
      "minProperties": 2
    }
  }
}
